<Window x:Class="CRUD.MeuPerfil "
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:CRUD"
        mc:Ignorable="d"
        Title="Meu Perfil" Height="550" Width="450"   
        WindowStartupLocation="CenterScreen" Background="#F5F5F5">
    
    <Grid Margin="30" >
        <!-- Definição das Linhas da Interface -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Foto de Perfil -->
            <RowDefinition Height="Auto"/> <!-- Campos de Texto -->
            <RowDefinition Height="*"/>    <!-- Botões de Ação -->
        </Grid.RowDefinitions>

        <!-- 1. Ícone / Foto de Perfil (Clique na borda para alterar) -->
        <Ellipse Width="100" Height="100" 
                 Fill="LightGray" 
                 Stroke="#CCCCCC" StrokeThickness="1" 
                 Cursor="Hand">
            <Ellipse.OpacityMask>
                <!-- Garante que qualquer imagem inserida fique perfeitamente redonda -->
                <ImageBrush ImageSource="https://cdn-icons-png.flaticon.com/512/5675/5675152.png"/>
            </Ellipse.OpacityMask>
        </Ellipse>

        <!-- 2. Formulário de Informações -->
        <StackPanel Grid.Row="1" VerticalAlignment="Center">
            <!-- Campo: Nome -->
            <TextBlock Text="Nome:" Margin="0,0,0,5" FontWeight="SemiBold" Foreground="Black"/>
            <TextBox x:Name="txtNome" Padding="5" Height="30" Margin="0,0,0,15"/>

            <!-- Campo: Usuário -->
            <TextBlock Text="Username:" Margin="0,0,0,5" FontWeight="SemiBold" Foreground="Black"/>
            <TextBox x:Name="txtUsuario" Padding="5" Height="30" Margin="0,0,0,15"/>

            <!-- Campo: E-mail -->
            <TextBlock Text="E-mail:" Margin="0,0,0,5" FontWeight="SemiBold" Foreground="Black"/>
            <TextBox x:Name="txtEmail" Padding="5" Height="30" Margin="0,0,0,15"/>

            <!-- Campo: Senha -->
            <TextBlock Text="Nova Senha:" Margin="0,0,0,5" FontWeight="SemiBold" Foreground="Black"/>
            <PasswordBox x:Name="txtSenha" Padding="5" Height="30" Margin="0,0,0,20"/>
        </StackPanel>

        <!-- 3. Botões de Ação -->
        <StackPanel Grid.Row="2" VerticalAlignment="Bottom">
            <!-- Botão Salvar / Alterar -->
            <Button x:Name="btnSalvar" Content="Salvar Alterações" Height="40" Margin="0,0,0,10"
                    Background="Chartreuse" Foreground="Black" FontWeight="Bold" BorderThickness="0"
                    Click="BtnSalvar_OnClick">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="5"/>
                    </Style>
                </Button.Resources>
            </Button>

            <!-- Botão Deletar Perfil -->
            <Button x:Name="btnDeletar" Content="Excluir Conta" Height="20" 
                    Background="Transparent" Foreground="Black" FontWeight="Bold" BorderThickness="0"
                    Click="BtnDeletar_OnClick">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="5"/>
                    </Style>
                </Button.Resources>
            </Button>
        </StackPanel>
    </Grid>
</Window>
