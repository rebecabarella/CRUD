<Window x:Class="CRUD.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:CRUD"
        mc:Ignorable="d"
        Title="Login de usuário" Height="450" Width="800">
        <Grid VerticalAlignment="Center" HorizontalAlignment="Center" Width="300">
                <StackPanel>
            
                        <!-- Título da Tela -->
                        <TextBlock Text="Bem-vindo" 
                                   FontSize="28" 
                                   FontWeight="Bold" 
                                   Foreground="#2F3640" 
                                   HorizontalAlignment="Center" 
                                   Margin="0,0,0,10"/>

                        <!-- Campo de Usuário -->
                        <StackPanel>
                                <TextBlock Text="Usuário" Foreground="#718093" Margin="0,0,0,5" FontWeight="SemiBold"/>
                                <TextBox x:Name="TxtUsuario" 
                                         Height="35" 
                                         Padding="5,0" 
                                         VerticalContentAlignment="Center" 
                                         FontSize="14"/>
                                
                                <TextBlock Text="Senha" Foreground="#718093" Margin="0,0,0,5" FontWeight="SemiBold"/>
                                <PasswordBox x:Name="TxtSenha" 
                                         Height="35" 
                                         Padding="5,0" 
                                         VerticalContentAlignment="Center" 
                                         FontSize="14"/>
                        </StackPanel>
                        
                        <!-- Botão de Login -->
                        <Button x:Name="BtnLogin" 
                                Content="Entrar" 
                                Height="40" 
                                Background="#555555" 
                                Foreground="White" 
                                FontSize="16" 
                                FontWeight="Bold" 
                                Cursor="Hand"
                                Margin="0,10,0,0"
                                Click="BtnLogin_OnClick"/>

                        <!-- Botão de Cadastro -->
                        <Button x:Name="BtnCadastrar" 
                                Content="Não tem uma conta? Cadastre-se" 
                                Background="Transparent" 
                                BorderThickness="0" 
                                Foreground="#718093" 
                                Cursor="Hand" 
                                HorizontalAlignment="Center"
                                Margin="0,5,0,0"
                                Click="BtnCadastrar_OnClick"/>
            
                </StackPanel>
        </Grid>
</Window>
