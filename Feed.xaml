<Window x:Class="CRUD.Feed"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:modelos="clr-namespace:CRUD.Modelos"
        xmlns:utils="clr-namespace:CRUD.Utils"
        mc:Ignorable="d"
        Title="Feed" Height="680" Width="800"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="BotaoBorda" TargetType="Button">
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
    </Window.Resources>
    
    <Window.DataContext>
        <utils:FeedViewModel />
    </Window.DataContext>

    <Grid>
        <Border Background="White"
                CornerRadius="8"
                Padding="30"
                Width="420"
                Height="600"
                VerticalAlignment="Center"
                HorizontalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" Direction="-90" RenderingBias="Quality" ShadowDepth="2" Opacity="0.1" />
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="Feed Social"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="#111827"
                           Margin="0,0,0,20"
                           HorizontalAlignment="Center" />

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden">
                    <StackPanel>
                        <ItemsControl x:Name="ItemsControlFeed" ItemsSource="{Binding Postagens}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type modelos:Postagem}">
                                    <Border BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Margin="0,0,0,20"
                                            Padding="0,0,0,15">
                                        <StackPanel>
                                            <DockPanel Margin="0,0,0,10">
                                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                                    <TextBlock Text="{Binding Usuario.Nome}"
                                                               FontWeight="Bold"
                                                               FontSize="14"
                                                               Foreground="#111827" />
                                                    <TextBlock Text="{Binding Usuario.Username, StringFormat='@{0}' }"
                                                               Foreground="#374151"
                                                               FontSize="13"
                                                               Margin="5,0,0,0"
                                                               Opacity="0.7" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding PostadoEm, StringFormat='dd MMM - HH:mm'}"
                                                           Foreground="#374151"
                                                           FontSize="12"
                                                           Opacity="0.5"
                                                           HorizontalAlignment="Right"
                                                           VerticalAlignment="Center" />
                                            </DockPanel>

                                            <TextBlock
                                                Text="{Binding Conteudo}"
                                                TextWrapping="Wrap"
                                                FontSize="14"
                                                Foreground="#374151"
                                                Margin="0,0,0,15" />

                                            <StackPanel Orientation="Horizontal">

                                                <Button Content="❤️ Curtir"
                                                        Height="35"
                                                        Width="100"
                                                        HorizontalAlignment="Left"
                                                        FontWeight="Bold"
                                                        BorderThickness="0"
                                                        Cursor="Hand"
                                                        Click="BtnCurtir_OnClick"
                                                        Tag="{Binding}">
                                                    <Button.Style>
                                                        <Style TargetType="Button">
                                                            <Setter Property="Background" Value="Transparent" />
                                                            <Setter Property="Foreground" Value="#2563EB" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding FoiCurtido}"
                                                                             Value="True">
                                                                    <Setter Property="Foreground" Value="#FF0000" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>

                                                <TextBlock VerticalAlignment="Center"
                                                           Margin="8,0"
                                                           Text="{Binding Curtidas, StringFormat='{}{0} curtidas'}" />
                                                
                                                <Button Background="Transparent" 
                                                        Style="{StaticResource BotaoBorda}"
                                                        Margin="4,0">
                                                    <Path 
                                                        Data="M308-140q-37 0-61.5-24.5T222-226v-498h-40v-54h176v-36h246v36h176v54h-40v498q0 36.73-24.64 61.36Q690.72-140 654-140H308Zm378-584H276v498q0 14 9 23t23 9h346q12 0 22-10t10-22v-498ZM381-275h54v-368h-54v368Zm146 0h54v-368h-54v368ZM276-724v530-530Z"
                                                        Width="12"
                                                        Height="12"
                                                        Fill="Black"
                                                        Stretch="Fill"
                                                    />
                                                    
                                                </Button>
                                                <Button Background="Transparent"
                                                        Style="{StaticResource BotaoBorda}"
                                                        Margin="4,0">
                                                    <Path 
                                                        Data= "M184-389.62v-43.76h306.23v43.76H184Zm0-171.69v-43.77h471.85v43.77H184Zm0-170.92V-776h471.85v43.77H184ZM532.23-184v-97.38l215.31-214.31q6.92-6.98 14.44-9.53 7.52-2.55 15.05-2.55 8.2 0 15.91 2.58 7.72 2.57 13.98 8.73l37 38.77q6.16 6.92 9.12 14.06 2.96 7.13 2.96 15.26 0 8.14-3.43 15.72t-8.79 14.34L629.62-184h-97.39Zm282.39-244.62-37-37.76 37 37.76Zm-240 202.24h38l138.69-138.93-18.77-19-18.23-19.54-139.69 139.47v38Zm157.92-157.93-18.23-19.54 37 38.54-18.77-19Z"
                                                        Width="12"
                                                        Height="12"
                                                        Fill="Black"
                                                        Stretch="Fill"/>
                                                    
                                                </Button>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <Button Width="56"
                Height="56"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="0,0,30,100"
                Cursor="Hand"
                Click="BtnPerfil_OnClick">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="ButtonBorder"
                                Background="#2563EB"
                                CornerRadius="28">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="8" Direction="-90" ShadowDepth="3" Opacity="0.3" />
                            </Border.Effect>
                            <Path 
                                Data ="M367-527q-47-47-47-113t47-113q47-47 113-47t113 47q47 47 47 113t-47 113q-47 47-113 47t-113-47ZM160-160v-112q0-34 17.5-62.5T224-378q62-31 126-46.5T480-440q66 0 130 15.5T736-378q29 15 46.5 43.5T800-272v112H160Zm80-80h480v-32q0-11-5.5-20T700-306q-54-27-109-40.5T480-360q-56 0-111 13.5T260-306q-9 5-14.5 14t-5.5 20v32Zm296.5-343.5Q560-607 560-640t-23.5-56.5Q513-720 480-720t-56.5 23.5Q400-673 400-640t23.5 56.5Q447-560 480-560t56.5-23.5ZM480-640Zm0 400Z"
                                Height="24"
                                Width="24"
                                Fill="White"
                                Stretch="Fill"
                                />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Background" Value="#1D4ED8" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>

        <Button Width="56"
                Height="56"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="0,0,30,30"
                Cursor="Hand"
                Click="BtnNovoPost_OnClick">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="ButtonBorder"
                                Background="#2563EB"
                                CornerRadius="28">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="8" Direction="-90" ShadowDepth="3" Opacity="0.3" />
                            </Border.Effect>
                            <Path 
                                Data= "M80 0v-160h800V0H80Zm160-320h56l312-311-29-29-28-28-311 312v56Zm-80 80v-170l448-447q11-11 25.5-17t30.5-6q16 0 31 6t27 18l55 56q12 11 17.5 26t5.5 31q0 15-5.5 29.5T777-687L330-240H160Zm560-504-56-56 56 56ZM608-631l-29-29-28-28 57 57Z"
                                 Width="24"
                                 Height="24"
                                 Fill="White"
                                 Stretch="Fill"
                                 />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Background" Value="#1D4ED8" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>

    </Grid>
</Window>